{% extends 'base.html.twig' %}
{% macro money(grosz, locale) %}{{ (grosz / 100)|number_format(2, locale == 'pl' ? ',' : '.', locale == 'pl' ? ' ' : ',') }} {{ locale == 'pl' ? 'zł' : 'PLN' }}{% endmacro %}
{% macro smart_money(grosz, locale) %}
    {%- set pln = grosz / 100 -%}
    {%- if pln <= 0 -%}
        0 {{ locale == 'pl' ? 'zł' : 'PLN' }}
    {%- elseif pln < 100 -%}
        {%- set rounded = ((pln / 5)|round) * 5 -%}
        {{ rounded|number_format(0, locale == 'pl' ? ',' : '.', locale == 'pl' ? ' ' : ',') }} {{ locale == 'pl' ? 'zł' : 'PLN' }}
    {%- elseif pln < 2000 -%}
        {%- set rounded = ((pln / 10)|round) * 10 -%}
        {{ rounded|number_format(0, locale == 'pl' ? ',' : '.', locale == 'pl' ? ' ' : ',') }} {{ locale == 'pl' ? 'zł' : 'PLN' }}
    {%- elseif pln <= 20000 -%}
        {%- set rounded = ((pln / 100)|round) * 100 -%}
        {{ rounded|number_format(0, locale == 'pl' ? ',' : '.', locale == 'pl' ? ' ' : ',') }} {{ locale == 'pl' ? 'zł' : 'PLN' }}
    {%- else -%}
        {%- set rounded = ((pln / 500)|round) * 500 -%}
        {{ rounded|number_format(0, locale == 'pl' ? ',' : '.', locale == 'pl' ? ' ' : ',') }} {{ locale == 'pl' ? 'zł' : 'PLN' }}
    {%- endif -%}
{% endmacro %}
{% macro localized_label(label, locale) %}{{- locale == 'pl' ? label|replace({'-inch': '″', ' petrol': ' benzyna'}) : label -}}{% endmacro %}
{% block title %}{{ 'market.meta.title'|trans }}{% endblock %}
{% block robots %}<meta name="robots" content="index,follow">{% endblock %}
{% block description %}<meta name="description" content="{{ 'market.meta.description'|trans }}">{% endblock %}
{% block canonical %}
    <link rel="canonical" href="{{ app.request.locale == 'pl' ? 'https://ileza.pl/' : 'https://ileza.pl/en/' }}">
    <link rel="alternate" hreflang="en" href="https://ileza.pl/en/">
    <link rel="alternate" hreflang="pl" href="https://ileza.pl/">
    <link rel="alternate" hreflang="x-default" href="https://ileza.pl/">
{% endblock %}
{% block stylesheets %}<link rel="stylesheet" href="/tools.css"><link rel="stylesheet" href="/market.css"><link rel="stylesheet" href="/market-extra.css">{% endblock %}
{% block language_switch %}<a class="language-switch" href="{{ path('market_home', {_locale: app.request.locale == 'pl' ? 'en' : 'pl'}) }}" hreflang="{{ app.request.locale == 'pl' ? 'en' : 'pl' }}">{{ app.request.locale == 'pl' ? 'EN' : 'PL' }}</a>{% endblock %}
{% block body %}
    <section class="tool-shell market-shell">
        <div class="eyebrow">{{ 'market.eyebrow'|trans }}</div>
        <h1>{{ 'market.heading_start'|trans }}</h1>
        <p class="lede">{{ 'market.lede'|trans }}</p>

        {% set search_products = [] %}
        {% for item in families %}
            {% for config in item.configurations %}
                {% set spec_text = [] %}
                {% for k, v in config.product.specifications %}
                    {% set spec_text = spec_text|merge([v]) %}
                {% endfor %}
                {% set search_products = search_products|merge([{
                    slug: config.product.slug,
                    name: _self.localized_label(config.product.name, app.request.locale),
                    category: config.product.category,
                    category_label: ('market.category.' ~ config.product.category)|trans,
                    price: config.latest ? _self.smart_money(config.latest.medianGrosz, app.request.locale) : 'market.awaiting'|trans,
                    url: path('market_product', {_locale: app.request.locale, slug: config.product.slug}),
                    search_text: (config.product.name ~ ' ' ~ spec_text|join(' ') ~ ' ' ~ config.product.category ~ ' ' ~ item.family.name)|lower
                }]) %}
            {% endfor %}
        {% endfor %}

        <div class="market-hero-search" data-hero-search data-products="{{ search_products|json_encode }}" data-locale="{{ app.request.locale }}">
            <div class="search-input-wrap">
                <span class="search-icon" aria-hidden="true">🔍</span>
                <label for="market-hero-input" class="visually-hidden">{{ 'market.search.label'|trans }}</label>
                <input id="market-hero-input"
                       type="search"
                       class="market-hero-input"
                       placeholder="{{ 'market.search.placeholder'|trans }}"
                       autocomplete="off"
                       spellcheck="false"
                       aria-autocomplete="list"
                       aria-expanded="false"
                       aria-controls="market-search-results">
                <button type="button" class="search-clear-btn" aria-label="Clear search" hidden>✕</button>
            </div>

            <div class="search-chips-row">
                <span class="search-chips-label">{{ 'market.search.quick_label'|trans }}</span>
                <button type="button" class="search-chip" data-search-chip="iPhone 13">iPhone 13</button>
                <button type="button" class="search-chip" data-search-chip="MacBook Air M1">MacBook Air M1</button>
                <button type="button" class="search-chip" data-search-chip="DDR5 32GB">DDR5 32GB</button>
                <button type="button" class="search-chip" data-search-chip="Peugeot 206 CC">Peugeot 206 CC</button>
            </div>

            <div id="market-search-results"
                 class="market-search-dropdown"
                 role="listbox"
                 aria-label="{{ 'market.search.label'|trans }}"
                 hidden
                 data-no-results="{{ 'market.search.no_results'|trans }}"
                 data-request-prompt="{{ 'market.search.request_prompt'|trans }}"
                 data-request-cta="{{ 'market.search.request_cta'|trans }}">
            </div>
        </div>

        <ul class="market-service-strip" aria-label="IleZa service information">
            <li><strong>{{ families|length }}</strong><span>{{ app.request.locale == 'pl' ? 'kategorie obserwowane' : 'tracked categories' }}</span></li>
            <li><strong>PLN</strong><span>{{ app.request.locale == 'pl' ? 'ceny z polskiego rynku' : 'Polish market prices' }}</span></li>
            <li><strong>↻</strong><span>{{ app.request.locale == 'pl' ? 'ręcznie weryfikowane' : 'manually verified' }}</span></li>
        </ul>

        <div class="market-products">
            {% for item in families %}
                {% set initial = item.configurations[0] %}
                <article class="market-product" data-market-family>
                    <figure><img src="{{ item.family.image }}" alt="{{ _self.localized_label(item.family.name, app.request.locale) }}" width="640" height="480" loading="lazy"><figcaption><a href="{{ item.family.imageSource }}">{{ item.family.imageCredit }}</a> · <a href="https://creativecommons.org/licenses/by-sa/4.0/">CC BY-SA 4.0</a></figcaption></figure>
                    <div class="market-product-body">
                        <span class="market-category">{{ ('market.category.' ~ item.family.category)|trans }}</span>
                        <h2>{{ _self.localized_label(item.family.name, app.request.locale) }}</h2>
                        <label for="configuration-{{ item.family.slug }}">{{ 'market.choose_configuration'|trans }}</label>
                        <select id="configuration-{{ item.family.slug }}" data-market-select>
                            {% for configuration in item.configurations %}
                                <option value="{{ path('market_product', {_locale: app.request.locale, slug: configuration.product.slug}) }}" data-price="{{ configuration.latest ? _self.smart_money(configuration.latest.medianGrosz, app.request.locale) : 'market.awaiting'|trans }}" data-note="{{ configuration.latest ? ('market.observed'|trans ~ ' ' ~ configuration.latest.observedAt|date(app.request.locale == 'pl' ? 'd.m.Y' : 'M j, Y')) : 'market.awaiting_note'|trans }}">{{ _self.localized_label(configuration.product.name|replace({(item.family.name ~ ' '): ''}), app.request.locale) }}</option>
                            {% endfor %}
                        </select>
                        <strong data-market-price>{{ initial.latest ? _self.smart_money(initial.latest.medianGrosz, app.request.locale) : 'market.awaiting'|trans }}</strong>
                        <small data-market-note>{{ initial.latest ? ('market.observed'|trans ~ ' ' ~ initial.latest.observedAt|date(app.request.locale == 'pl' ? 'd.m.Y' : 'M j, Y')) : 'market.awaiting_note'|trans }}</small>
                        <div class="market-configurations-list" aria-label="{{ 'market.choose_configuration'|trans }}">
                            {% for configuration in item.configurations %}
                                <a class="market-config-chip" href="{{ path('market_product', {_locale: app.request.locale, slug: configuration.product.slug}) }}">{{ _self.localized_label(configuration.product.name|replace({(item.family.name ~ ' '): ''}), app.request.locale) }}</a>
                            {% endfor %}
                        </div>
                        <a class="market-open" data-market-link href="{{ path('market_product', {_locale: app.request.locale, slug: initial.product.slug}) }}">{{ 'market.open_history'|trans }} →</a>
                    </div>
                </article>
            {% endfor %}
        </div>

        <section class="market-request">
            <div><span class="market-category">{{ 'market.request.eyebrow'|trans }}</span><h2>{{ 'market.request.title'|trans }}</h2><p>{{ 'market.request.text'|trans }}</p></div>
            <form class="lead-form" method="post" action="{{ path('market_request', {_locale: app.request.locale}) }}" data-product-request-form data-saving="{{ 'market.request.saving'|trans }}" data-fallback="{{ 'market.request.failed'|trans }}">
                <label for="requested-product">{{ 'market.request.product'|trans }}</label>
                <input id="requested-product" name="product" maxlength="160" placeholder="{{ 'market.request.placeholder'|trans }}" required>
                <label for="request-email">{{ 'market.request.email'|trans }}</label>
                <div class="lead-row"><input id="request-email" name="email" type="email" maxlength="254" autocomplete="email" placeholder="you@example.com"><button type="submit">{{ 'market.request.submit'|trans }}</button></div>
                <label class="lead-trap" aria-hidden="true">{{ 'contact.company'|trans }}<input name="company" tabindex="-1" autocomplete="off"></label>
                <small>{{ 'market.request.note'|trans }}</small><p class="lead-status" data-contact-status aria-live="polite"></p>
            </form>
        </section>

        <aside class="market-method"><strong>{{ 'market.method.title'|trans }}</strong><p>{{ 'market.method.text'|trans }}</p><ul><li>{{ 'market.method.one'|trans }}</li><li>{{ 'market.method.two'|trans }}</li><li>{{ 'market.method.three'|trans }}</li></ul></aside>
        <section class="market-mcp"><div><span class="market-category">{{ 'market.mcp.eyebrow'|trans }}</span><h2>{{ 'market.mcp.title'|trans }}</h2><p>{{ 'market.mcp.text'|trans }}</p></div><code>https://ileza.pl/mcp</code></section>
    </section>
{% endblock %}
{% block scripts %}<script src="/market-index.js" defer></script>{% endblock %}
