{% macro smart_money(grosz, locale) %}
    {%- set pln = grosz / 100 -%}
    {%- set step = pln < 100 ? 5 : (pln < 2000 ? 10 : (pln <= 20000 ? 100 : 500)) -%}
    {{ ((pln / step)|round * step)|number_format(0, locale == 'pl' ? ',' : '.', locale == 'pl' ? ' ' : ',') }}{{ ' ' }}{{ locale == 'pl' ? 'zł' : 'PLN' }}
{% endmacro %}
<aside class="blog-price-embed" aria-label="{{ 'blog.live_price'|trans }}">
    <div>
        <span class="market-category">{{ 'blog.live_price'|trans }}</span>
        <strong>{{ product.name }}</strong>
        {% if latest %}
            <small>{{ 'market.observed'|trans }} {{ latest.observedAt|date(app.request.locale == 'pl' ? 'd.m.Y' : 'M j, Y') }}</small>
        {% else %}
            <small>{{ 'market.awaiting_note'|trans }}</small>
        {% endif %}
    </div>
    <div class="blog-price-value">
        <strong>{{ latest ? _self.smart_money(latest.medianGrosz, app.request.locale) : 'market.awaiting'|trans }}</strong>
        <a href="{{ path('market_product', {_locale: app.request.locale, slug: product.slug}) }}">{{ 'market.open_history'|trans }} →</a>
    </div>
</aside>
