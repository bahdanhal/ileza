{% extends 'base.html.twig' %}
{% macro money(grosz) %}{{ (grosz / 100)|number_format(2, '.', ' ') }} PLN{% endmacro %}
{% block tool_name %}Market Admin{% endblock %}
{% block title %}Market Admin Dashboard · Bahdan's Toolbox{% endblock %}
{% block robots %}<meta name="robots" content="noindex,nofollow">{% endblock %}
{% block stylesheets %}
    <link rel="stylesheet" href="/tools.css">
    <link rel="stylesheet" href="/market.css">
    <link rel="stylesheet" href="/market-extra.css">
    <style>
        .admin-nav { display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px; padding-bottom: 16px; border-bottom: 1px solid var(--line); }
        .admin-cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(360px, 1fr)); gap: 20px; margin-bottom: 36px; }
        .admin-card { background: var(--panel); border: 1px solid var(--line); border-radius: 14px; padding: 24px; }
        .admin-card h2 { font-family: Georgia, serif; font-size: 22px; margin: 0 0 16px; }
        .admin-form-group { display: flex; flex-direction: column; gap: 6px; margin-bottom: 14px; }
        .admin-form-group label { font-size: 11px; font-weight: 800; text-transform: uppercase; color: var(--muted); }
        .admin-form-group input, .admin-form-group select, .admin-form-group textarea { padding: 10px 12px; border: 1px solid var(--line); border-radius: 8px; background: #fff; font: inherit; font-size: 14px; color: var(--ink); }
        .admin-form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
        .admin-btn { background: var(--orange); color: #fff; border: 0; padding: 10px 18px; border-radius: 8px; font: inherit; font-weight: 800; cursor: pointer; transition: opacity 0.15s ease; }
        .admin-btn:hover { opacity: 0.9; }
        .admin-btn-secondary { background: #334155; color: #fff; }
        .admin-btn-danger { background: #dc2626; color: #fff; }
        .admin-btn-subtle { background: rgba(255, 255, 255, 0.08); border: 1px solid var(--line); color: var(--ink); }
        .admin-table { width: 100%; border-collapse: collapse; margin-top: 16px; font-size: 13px; }
        .admin-table th, .admin-table td { padding: 10px 12px; border-bottom: 1px solid var(--line); text-align: left; }
        .admin-table th { font-weight: 800; color: var(--muted); font-size: 11px; text-transform: uppercase; }
        .admin-filters { display: flex; gap: 8px; flex-wrap: wrap; align-items: center; margin-bottom: 16px; }
        .filter-chip { padding: 6px 14px; border-radius: 20px; border: 1px solid var(--line); background: var(--panel); font-size: 12px; font-weight: 700; color: var(--ink); text-decoration: none; }
        .filter-chip.active { background: var(--orange); color: #fff; border-color: var(--orange); }
        .alert-success { background: rgba(99, 214, 170, 0.15); border: 1px solid var(--green); color: var(--green); padding: 12px 16px; border-radius: 8px; margin-bottom: 20px; font-weight: 700; }
        .alert-error { background: rgba(255, 125, 138, 0.15); border: 1px solid var(--red); color: var(--red); padding: 12px 16px; border-radius: 8px; margin-bottom: 20px; font-weight: 700; }
        .badge { display: inline-block; padding: 3px 8px; border-radius: 6px; font-size: 10px; font-weight: 800; text-transform: uppercase; }
        .badge-smartphones { background: rgba(56, 189, 248, 0.15); color: #38bdf8; }
        .badge-laptops { background: rgba(168, 85, 247, 0.15); color: #a855f7; }
        .badge-ram { background: rgba(251, 191, 36, 0.15); color: #fbbf24; }
        .badge-cars { background: rgba(99, 214, 170, 0.15); color: #63d6aa; }
        .product-thumb { width: 36px; height: 36px; object-fit: cover; border-radius: 6px; border: 1px solid var(--line); vertical-align: middle; margin-right: 8px; }
        .statistics-section { margin-bottom: 36px; }
        .statistics-heading { display: flex; justify-content: space-between; align-items: end; gap: 16px; margin-bottom: 16px; }
        .statistics-heading h2 { font-family: Georgia, serif; font-size: 30px; margin: 0; }
        .statistics-heading p { color: var(--muted); font-size: 12px; margin: 0; max-width: 520px; text-align: right; }
        .stat-grid { display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 10px; margin-bottom: 12px; }
        .stat-card { min-width: 0; background: var(--panel); border: 1px solid var(--line); border-radius: 12px; padding: 16px; }
        .stat-card strong { display: block; font-family: Georgia, serif; font-size: 30px; line-height: 1; margin: 8px 0; }
        .stat-card-label { color: var(--muted); font-size: 10px; font-weight: 900; letter-spacing: .08em; text-transform: uppercase; }
        .stat-card-detail { color: var(--muted); display: block; font-size: 11px; line-height: 1.35; }
        .stat-card-warning strong { color: var(--amber); }
        .analytics-layout { display: grid; grid-template-columns: minmax(0, 2fr) minmax(260px, 1fr); gap: 12px; }
        .analytics-panel { background: var(--panel); border: 1px solid var(--line); border-radius: 12px; padding: 18px; min-width: 0; }
        .analytics-panel h3 { font-size: 14px; margin: 0; }
        .analytics-panel-head { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; margin-bottom: 16px; }
        .analytics-panel-head span { color: var(--muted); font-size: 11px; }
        .traffic-chart { display: grid; grid-template-columns: repeat(30, minmax(8px, 1fr)); align-items: end; gap: 4px; height: 180px; padding-top: 12px; border-bottom: 1px solid var(--line); }
        .traffic-day { align-items: stretch; align-self: stretch; display: flex; justify-content: end; flex-direction: column; gap: 5px; min-width: 0; }
        .traffic-bar-wrap { align-items: end; display: flex; flex: 1; gap: 2px; }
        .traffic-bar { background: var(--orange); border-radius: 4px 4px 1px 1px; flex: 1; min-height: 2px; opacity: .9; }
        .traffic-bar-visitors { background: var(--green); opacity: .65; }
        .traffic-date { color: var(--muted); font-size: 8px; height: 12px; overflow: visible; white-space: nowrap; }
        .traffic-legend { color: var(--muted); display: flex; gap: 14px; font-size: 10px; margin-top: 10px; }
        .traffic-legend i { border-radius: 2px; display: inline-block; height: 7px; margin-right: 5px; width: 7px; }
        .analytics-sidebar { display: grid; gap: 12px; }
        .ranking-list { display: grid; gap: 12px; margin-top: 16px; }
        .ranking-row { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 5px 10px; font-size: 12px; }
        .ranking-row span { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
        .ranking-row strong { font-size: 11px; }
        .ranking-track { background: var(--line); border-radius: 999px; grid-column: 1 / -1; height: 3px; overflow: hidden; }
        .ranking-track i { background: var(--orange); display: block; height: 100%; }
        .ranking-empty { color: var(--muted); font-size: 12px; margin: 16px 0 0; }
        @media (max-width: 980px) {
            .stat-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
        }
        @media (max-width: 720px) {
            .statistics-heading { align-items: start; flex-direction: column; }
            .statistics-heading p { text-align: left; }
            .stat-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
            .analytics-layout { grid-template-columns: 1fr; }
            .traffic-chart { gap: 2px; overflow: hidden; }
            .traffic-date { display: none; }
        }
    </style>
{% endblock %}
{% block body %}
    <section class="tool-shell market-shell" style="max-width: 1200px;">
        <div class="admin-nav">
            <div>
                <a class="back" href="{{ path('market_home', {_locale: 'pl'}) }}">← View Public Site</a>
                <h1 style="font-size: 32px; margin-top: 8px;">Market <em>Admin Control Center</em></h1>
            </div>
            <div style="display: flex; gap: 8px; align-items: center;">
                <a href="{{ path('market_admin_blog_list') }}" class="admin-btn" style="text-decoration: none; font-size: 13px;">Poradniki &amp; Blog</a>
                <a href="{{ path('market_admin_logout') }}" class="admin-btn admin-btn-secondary" style="text-decoration: none; font-size: 13px;">Log Out</a>
            </div>
        </div>

        {% if status %}
            <div class="alert-success">✓ {{ status }}</div>
        {% endif %}
        {% if error %}
            <div class="alert-error">✕ {{ error }}</div>
        {% endif %}

        <section id="statistics" class="statistics-section" aria-labelledby="statistics-title">
            <div class="statistics-heading">
                <h2 id="statistics-title">Site Statistics</h2>
                <p>{{ traffic.privacy }}</p>
            </div>

            <div class="stat-grid">
                <article class="stat-card">
                    <span class="stat-card-label">Page views</span>
                    <strong>{{ traffic.last_7_days.page_views|number_format(0, '.', ' ') }}</strong>
                    <span class="stat-card-detail">Last 7 days · {{ traffic.last_30_days.page_views|number_format(0, '.', ' ') }} in 30 days</span>
                </article>
                <article class="stat-card">
                    <span class="stat-card-label">Unique visitors</span>
                    <strong>{{ traffic.last_7_days.unique_visitors|number_format(0, '.', ' ') }}</strong>
                    <span class="stat-card-detail">Last 7 days · {{ traffic.last_30_days.unique_visitors|number_format(0, '.', ' ') }} in 30 days</span>
                </article>
                <article class="stat-card">
                    <span class="stat-card-label">Product requests</span>
                    <strong>{{ requests|length }}</strong>
                    <span class="stat-card-detail">{{ statistics.requests_last_7_days }} received in the last 7 days</span>
                </article>
                <article class="stat-card">
                    <span class="stat-card-label">Price tips</span>
                    <strong>{{ price_tips|length }}</strong>
                    <span class="stat-card-detail">{{ statistics.price_tips_last_7_days }} received in the last 7 days</span>
                </article>
                <article class="stat-card">
                    <span class="stat-card-label">Catalog coverage</span>
                    <strong>{{ statistics.catalog_coverage_percent }}%</strong>
                    <span class="stat-card-detail">{{ statistics.observation_points }} price observations across {{ statistics.tracked_products }} products</span>
                </article>
                <article class="stat-card {{ statistics.stale_products > 0 ? 'stat-card-warning' : '' }}">
                    <span class="stat-card-label">Needs a price review</span>
                    <strong>{{ statistics.stale_products }}</strong>
                    <span class="stat-card-detail">Missing or older than 30 days</span>
                </article>
            </div>

            <div class="analytics-layout">
                <article class="analytics-panel">
                    <div class="analytics-panel-head">
                        <h3>Traffic activity</h3>
                        <span>Last 30 days</span>
                    </div>
                    <div class="traffic-chart" role="img" aria-label="Daily page views and unique visitors for the last 30 days">
                        {% for day in traffic.daily %}
                            <div class="traffic-day" title="{{ day.date }}: {{ day.page_views }} page views, {{ day.unique_visitors }} unique visitors">
                                <div class="traffic-bar-wrap">
                                    <i class="traffic-bar" style="height: {{ day.height_percent }}%"></i>
                                    <i class="traffic-bar traffic-bar-visitors" style="height: {{ day.page_views > 0 ? (day.unique_visitors / day.page_views * day.height_percent)|round : 2 }}%"></i>
                                </div>
                                <span class="traffic-date">{{ loop.first or loop.last or loop.index % 5 == 0 ? day.date|date('M j') : '' }}</span>
                            </div>
                        {% endfor %}
                    </div>
                    <div class="traffic-legend">
                        <span><i style="background: var(--orange);"></i>Page views</span>
                        <span><i style="background: var(--green);"></i>Unique visitors</span>
                    </div>
                </article>

                <div class="analytics-sidebar">
                    <article class="analytics-panel">
                        <div class="analytics-panel-head">
                            <h3>Traffic sources</h3>
                            <span>30 days</span>
                        </div>
                        <div class="ranking-list">
                            {% for source, count in traffic.last_30_days.sources %}
                                <div class="ranking-row">
                                    <span title="{{ source }}">{{ source|replace({'_': ' '})|title }}</span>
                                    <strong>{{ count }}</strong>
                                    <div class="ranking-track"><i style="width: {{ traffic.last_30_days.page_views > 0 ? (count / traffic.last_30_days.page_views * 100)|round : 0 }}%"></i></div>
                                </div>
                            {% else %}
                                <p class="ranking-empty">No traffic recorded yet.</p>
                            {% endfor %}
                        </div>
                    </article>

                    <article class="analytics-panel">
                        <div class="analytics-panel-head">
                            <h3>Popular pages</h3>
                            <span>30 days</span>
                        </div>
                        <div class="ranking-list">
                            {% for page, count in traffic.last_30_days.top_paths|slice(0, 5) %}
                                <div class="ranking-row">
                                    <span title="{{ page }}">{{ page }}</span>
                                    <strong>{{ count }}</strong>
                                    <div class="ranking-track"><i style="width: {{ traffic.last_30_days.page_views > 0 ? (count / traffic.last_30_days.page_views * 100)|round : 0 }}%"></i></div>
                                </div>
                            {% else %}
                                <p class="ranking-empty">No page data recorded yet.</p>
                            {% endfor %}
                        </div>
                    </article>
                </div>
            </div>
        </section>

        <div class="admin-cards">
            <!-- EDITORIAL PRICE ENTRY (0 TOKENS) -->
            <div class="admin-card">
                <h2>⚡ Editorial Price Entry</h2>
                <p style="font-size: 13px; color: var(--muted); margin-bottom: 16px;">Directly write or update market observation for a product configuration.</p>
                <form method="post" action="{{ path('market_admin_save_observation') }}">
                    <input type="hidden" name="_token" value="{{ admin_csrf_token('market_admin_save_observation') }}">
                    <div class="admin-form-group">
                        <label for="entry-slug">Product</label>
                        <select id="entry-slug" name="product_slug" required>
                            <option value="">-- Select Product --</option>
                            {% for prod in all_products %}
                                <option value="{{ prod.slug }}">{{ prod.name }} ({{ prod.slug }})</option>
                            {% endfor %}
                        </select>
                    </div>
                    <div class="admin-form-row">
                        <div class="admin-form-group">
                            <label for="entry-date">Observation Date</label>
                            <input id="entry-date" name="observed_at" type="date" value="{{ 'now'|date('Y-m-d') }}" required>
                        </div>
                        <div class="admin-form-group">
                            <label for="entry-median">Fair Price PLN</label>
                            <input id="entry-median" name="median_pln" type="number" step="0.01" min="1" placeholder="e.g. 2150" required>
                        </div>
                    </div>
                    <div class="admin-form-row">
                        <div class="admin-form-group">
                            <label for="entry-low">Reasonable Low PLN</label>
                            <input id="entry-low" name="low_pln" type="number" step="0.01" min="1" placeholder="e.g. 1900" required>
                        </div>
                        <div class="admin-form-group">
                            <label for="entry-high">Reasonable High PLN</label>
                            <input id="entry-high" name="high_pln" type="number" step="0.01" min="1" placeholder="e.g. 2400" required>
                        </div>
                    </div>
                    <div class="admin-form-row">
                        <div class="admin-form-group">
                            <label for="entry-availability">Availability</label>
                            <select id="entry-availability" name="availability">
                                <option value="available" selected>Available</option>
                                <option value="unavailable">Unavailable</option>
                            </select>
                        </div>
                    </div>
                    <button type="submit" class="admin-btn" style="width: 100%; margin-top: 8px;">Save Observation</button>
                </form>
            </div>

            <!-- PRODUCT MANAGEMENT (CREATE / EDIT WITH PHOTO) -->
            <div class="admin-card" id="product-editor-card">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;">
                    <h2 id="product-editor-title" style="margin: 0;">📦 Product Editor</h2>
                    <button type="button" class="admin-btn admin-btn-subtle" style="padding: 4px 10px; font-size: 11px;" onclick="resetProductForm();">+ New Product</button>
                </div>
                <p style="font-size: 13px; color: var(--muted); margin-bottom: 16px;">Add or edit product configurations, specifications, and upload photos.</p>
                <form id="product-form" method="post" action="{{ path('market_admin_save_product') }}" enctype="multipart/form-data">
                    <input type="hidden" name="_token" value="{{ admin_csrf_token('market_admin_save_product') }}">
                    <div class="admin-form-row">
                        <div class="admin-form-group">
                            <label for="prod-slug">Slug (URL identifier)</label>
                            <input id="prod-slug" name="slug" type="text" placeholder="e.g. iphone-15-pro-128gb" required pattern="[a-z0-9]+(?:-[a-z0-9]+)*">
                        </div>
                        <div class="admin-form-group">
                            <label for="prod-category">Category</label>
                            <input id="prod-category" name="category" type="text" list="product-categories" placeholder="e.g. cosmetics" required>
                            <datalist id="product-categories">
                                <option value="smartphones">Smartphones</option>
                                <option value="laptops">Laptops</option>
                                <option value="ram">RAM Memory</option>
                                <option value="cars">Cars</option>
                                <option value="cosmetics">Cosmetics</option>
                            </datalist>
                        </div>
                    </div>
                    <div class="admin-form-group">
                        <label for="prod-name">Product Name</label>
                        <input id="prod-name" name="name" type="text" placeholder="e.g. Apple iPhone 15 Pro 128 GB" required>
                    </div>
                    <div class="admin-form-group">
                        <label for="prod-definition">Product Identity & Estimate Scope</label>
                        <textarea id="prod-definition" name="definition" rows="2" placeholder="e.g. Exact model, capacity, size, or formulation covered by this estimate..." required></textarea>
                    </div>
                    <div class="admin-form-row">
                        <div class="admin-form-group">
                            <label for="prod-family-slug">Family Slug (optional)</label>
                            <input id="prod-family-slug" name="family_slug" type="text" placeholder="e.g. iphone-15">
                        </div>
                        <div class="admin-form-group">
                            <label for="prod-family-name">Family Name (optional)</label>
                            <input id="prod-family-name" name="family_name" type="text" placeholder="e.g. Apple iPhone 15">
                        </div>
                    </div>
                    <div class="admin-form-row">
                        <div class="admin-form-group">
                            <label for="prod-image-file">Upload Photo (JPG, PNG, WEBP, SVG)</label>
                            <input id="prod-image-file" name="image_file" type="file" accept="image/*">
                        </div>
                        <div class="admin-form-group">
                            <label for="prod-image-url">Or Existing Photo URL</label>
                            <input id="prod-image-url" name="image_url" type="text" placeholder="/images/market/iphone-15.jpg">
                        </div>
                    </div>
                    <div class="admin-form-row">
                        <div class="admin-form-group">
                            <label for="prod-image-credit">Photo Author / Credit</label>
                            <input id="prod-image-credit" name="image_credit" type="text" placeholder="e.g. John Doe">
                        </div>
                        <div class="admin-form-group">
                            <label for="prod-image-source">Photo Source URL</label>
                            <input id="prod-image-source" name="image_source" type="url" placeholder="https://commons.wikimedia.org/...">
                        </div>
                    </div>
                    <div class="admin-form-group" data-spec-editor>
                        <label>Configuration details</label>
                        <div class="admin-form-row">
                            <div class="admin-form-group"><label for="prod-spec-generation">Generation</label><select id="prod-spec-generation" data-spec-field="generation"><option value="">-</option>{% for value in ['iPhone X', 'iPhone 11', 'iPhone 12', 'iPhone 13', 'iPhone 14', 'iPhone 15', 'iPhone 16', 'iPhone 17'] %}<option value="{{ value }}">{{ value }}</option>{% endfor %}</select></div>
                            <div class="admin-form-group"><label for="prod-spec-variant">Variant</label><select id="prod-spec-variant" data-spec-field="variant"><option value="">-</option>{% for value in ['Standard', 'Mini', 'Plus', 'Pro', 'Pro Max'] %}<option value="{{ value }}">{{ value }}</option>{% endfor %}</select></div>
                        </div>
                        <div class="admin-form-row">
                            <div class="admin-form-group"><label for="prod-spec-display">Display</label><select id="prod-spec-display" data-spec-field="display"><option value="">-</option><option value="13-inch">13-inch</option><option value="14-inch">14-inch</option><option value="15-inch">15-inch</option><option value="16-inch">16-inch</option></select></div>
                            <div class="admin-form-group"><label for="prod-spec-chip">Chip</label><select id="prod-spec-chip" data-spec-field="chip"><option value="">-</option>{% for value in ['M1', 'M1 Pro', 'M1 Max', 'M2', 'M2 Pro', 'M2 Max', 'M3', 'M3 Pro', 'M3 Max', 'M4', 'A15', 'A16', 'A17', 'A18'] %}<option value="{{ value }}">{{ value }}</option>{% endfor %}</select></div>
                        </div>
                        <div class="admin-form-row">
                            <div class="admin-form-group"><label for="prod-spec-memory">Memory</label><select id="prod-spec-memory" data-spec-field="memory"><option value="">-</option>{% for value in ['4 GB', '8 GB', '16 GB', '18 GB', '24 GB', '32 GB', '36 GB', '48 GB', '64 GB'] %}<option value="{{ value }}">{{ value }}</option>{% endfor %}</select></div>
                            <div class="admin-form-group"><label for="prod-spec-storage">Storage</label><select id="prod-spec-storage" data-spec-field="storage"><option value="">-</option>{% for value in ['64 GB', '128 GB', '256 GB', '512 GB', '1 TB', '2 TB'] %}<option value="{{ value }}">{{ value }}</option>{% endfor %}</select></div>
                        </div>
                        <div class="admin-form-row">
                            <div class="admin-form-group"><label for="prod-spec-type">Type</label><select id="prod-spec-type" data-spec-field="type"><option value="">-</option>{% for value in ['DDR4', 'DDR5', 'LPDDR4', 'LPDDR5'] %}<option value="{{ value }}">{{ value }}</option>{% endfor %}</select></div>
                            <div class="admin-form-group"><label for="prod-spec-form-factor">Form factor</label><select id="prod-spec-form-factor" data-spec-field="form_factor"><option value="">-</option>{% for value in ['DIMM (Desktop)', 'SO-DIMM (Laptop)'] %}<option value="{{ value }}">{{ value }}</option>{% endfor %}</select></div>
                        </div>
                        <label for="prod-specifications">Additional specifications (JSON)</label>
                        <textarea id="prod-specifications" name="specifications" rows="2" placeholder='{"battery":"95%"}'></textarea>
                    </div>
                    <button type="submit" id="prod-submit-btn" class="admin-btn" style="width: 100%; margin-top: 8px;">Save Product</button>
                </form>
            </div>
        </div>

        <section class="section" style="margin-top: 0;">
            <div class="section-title">
                <h2>Catalog Products ({{ products|length }})</h2>
            </div>

            <div class="admin-filters">
                <a href="{{ path('market_admin_dashboard') }}" class="filter-chip {{ current_category is empty ? 'active' : '' }}">All ({{ all_products|length }})</a>
                <a href="{{ path('market_admin_dashboard', {category: 'smartphones'}) }}" class="filter-chip {{ current_category == 'smartphones' ? 'active' : '' }}">Smartphones</a>
                <a href="{{ path('market_admin_dashboard', {category: 'laptops'}) }}" class="filter-chip {{ current_category == 'laptops' ? 'active' : '' }}">Laptops</a>
                <a href="{{ path('market_admin_dashboard', {category: 'ram'}) }}" class="filter-chip {{ current_category == 'ram' ? 'active' : '' }}">RAM Memory</a>
                <a href="{{ path('market_admin_dashboard', {category: 'cars'}) }}" class="filter-chip {{ current_category == 'cars' ? 'active' : '' }}">Cars</a>

                <form method="get" action="{{ path('market_admin_dashboard') }}" style="margin-left: auto; display: flex; gap: 6px;">
                    {% if current_category %}<input type="hidden" name="category" value="{{ current_category }}">{% endif %}
                    <input name="q" value="{{ search }}" placeholder="Search products..." style="padding: 6px 10px; border: 1px solid var(--line); border-radius: 6px; font-size: 12px; background: #fff;">
                    <button type="submit" class="admin-btn" style="padding: 6px 12px; font-size: 12px;">Search</button>
                </form>
            </div>

            <div class="table-wrap" style="max-height: 480px; overflow-y: auto;">
                <table class="admin-table">
                    <thead>
                    <tr>
                        <th>Photo</th>
                        <th>Category</th>
                        <th>Product Name / Slug</th>
                        <th>Latest Median</th>
                        <th>Range</th>
                        <th>Observed Date</th>
                        <th>Points</th>
                        <th>Actions</th>
                    </tr>
                    </thead>
                    <tbody>
                    {% for item in products %}
                        {% set p = item.product %}
                        {% set lat = item.latest %}
                        {% set p_img = p.image|default('/images/market/' ~ p.category ~ '.svg') %}
                        <tr>
                            <td>
                                {% if p.image %}
                                    <img src="{{ p.image }}" alt="{{ p.name }}" class="product-thumb">
                                {% else %}
                                    <span style="display: inline-block; width: 36px; height: 36px; background: var(--line); border-radius: 6px; vertical-align: middle; margin-right: 8px;"></span>
                                {% endif %}
                            </td>
                            <td><span class="badge badge-{{ p.category }}">{{ p.category }}</span></td>
                            <td>
                                <strong>{{ p.name }}</strong><br>
                                <code style="font-size: 11px; color: var(--muted);">{{ p.slug }}</code>
                            </td>
                            <td>
                                {% if lat %}
                                    <strong>{{ _self.money(lat.medianGrosz) }}</strong>
                                {% else %}
                                    <span style="color: var(--muted);">No data</span>
                                {% endif %}
                            </td>
                            <td>
                                {% if lat %}
                                    {{ (lat.lowGrosz / 100)|round }}-{{ (lat.highGrosz / 100)|round }} PLN
                                {% else %}
                                    -
                                {% endif %}
                            </td>
                            <td>
                                {% if lat %}
                                    {{ lat.observedAt|date('Y-m-d') }}
                                {% else %}
                                    -
                                {% endif %}
                            </td>
                            <td>{{ item.observation_count }}</td>
                            <td style="white-space: nowrap;">
                                <a href="{{ path('market_product', {_locale: 'pl', slug: p.slug}) }}" target="_blank" style="color: var(--orange); font-weight: 700; text-decoration: none; margin-right: 6px;">View →</a>
                                <button type="button" class="admin-btn" style="padding: 4px 8px; font-size: 11px; margin-right: 4px;" onclick="populateEntryForm('{{ p.slug }}', '{{ lat ? (lat.medianGrosz / 100)|round : '' }}', '{{ lat ? (lat.lowGrosz / 100)|round : '' }}', '{{ lat ? (lat.highGrosz / 100)|round : '' }}');">Set Price</button>
                                <button type="button" class="admin-btn admin-btn-subtle" style="padding: 4px 8px; font-size: 11px; margin-right: 4px;" onclick='populateProductForm({{ {
                                    slug: p.slug,
                                    name: p.name,
                                    category: p.category,
                                    definition: p.definition,
                                    family_slug: p.familySlug|default(''),
                                    family_name: p.familyName|default(''),
                                    image: p.image|default(''),
                                    image_credit: p.imageCredit|default(''),
                                    image_source: p.imageSource|default(''),
                                    specifications: p.specifications|default({})
                                }|json_encode|e('html_attr') }});'>Edit</button>
                                <form method="post" action="{{ path('market_admin_delete_product') }}" style="display: inline;" onsubmit="return confirm('Delete product {{ p.slug }}?');">
                                    <input type="hidden" name="_token" value="{{ admin_csrf_token('market_admin_delete_product') }}">
                                    <input type="hidden" name="slug" value="{{ p.slug }}">
                                    <button type="submit" class="admin-btn admin-btn-danger" style="padding: 4px 8px; font-size: 11px;">✕</button>
                                </form>
                                {% if item.history is not empty %}
                                    <details style="margin-top: 8px; white-space: normal;">
                                        <summary style="cursor: pointer; color: var(--orange); font-size: 11px;">Edit history ({{ item.history|length }})</summary>
                                        <div style="display: grid; gap: 8px; margin-top: 8px; min-width: 360px;">
                                            {% for observation in item.history %}
                                                <form method="post" action="{{ path('market_admin_save_observation') }}" style="display: grid; grid-template-columns: 110px repeat(3, 1fr) auto; gap: 5px; align-items: center;">
                                                    <input type="hidden" name="_token" value="{{ admin_csrf_token('market_admin_save_observation') }}">
                                                    <input type="hidden" name="product_slug" value="{{ p.slug }}">
                                                    <input name="observed_at" type="date" value="{{ observation.observedAt|date('Y-m-d') }}" required>
                                                    <input name="median_pln" type="number" step="0.01" min="1" value="{{ (observation.medianGrosz / 100)|number_format(2, '.', '') }}" required aria-label="Median">
                                                    <input name="low_pln" type="number" step="0.01" min="1" value="{{ (observation.lowGrosz / 100)|number_format(2, '.', '') }}" required aria-label="Low">
                                                    <input name="high_pln" type="number" step="0.01" min="1" value="{{ (observation.highGrosz / 100)|number_format(2, '.', '') }}" required aria-label="High">
                                                    <input type="hidden" name="availability" value="{{ observation.availability }}">
                                                    <button type="submit" class="admin-btn" style="padding: 4px 8px; font-size: 11px;">Save</button>
                                                </form>
                                            {% endfor %}
                                        </div>
                                    </details>
                                {% endif %}
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </section>

        <section class="section" style="margin-top: 32px;">
            <div class="section-title">
                <h2>User Product Requests ({{ requests|length }})</h2>
                <span style="font-size: 12px; color: var(--muted);">Submitted from public request forms</span>
            </div>
            <div class="table-wrap" style="max-height: 320px; overflow-y: auto;">
                <table class="admin-table">
                    <thead>
                    <tr>
                        <th>Date</th>
                        <th>Requested Product</th>
                        <th>Email Contact</th>
                        <th>Visitor IP Hash</th>
                    </tr>
                    </thead>
                    <tbody>
                    {% for req in requests %}
                        <tr>
                            <td><time>{{ req.timestamp|date('Y-m-d H:i') }}</time></td>
                            <td><strong>{{ req.product }}</strong></td>
                            <td>{{ req.email ? req.email : '<span style="color: var(--muted);">None</span>'|raw }}</td>
                            <td><code>{{ req.ip_hash }}</code></td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="4" style="text-align: center; color: var(--muted); padding: 24px;">No user product requests submitted yet.</td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </section>

        <section class="section" style="margin-top: 32px;">
            <div class="section-title">
                <h2>Community Price Tips ({{ price_tips|length }})</h2>
                <span style="font-size: 12px; color: var(--muted);">Private review queue · automatically removed after 90 days</span>
            </div>
            <div class="table-wrap" style="max-height: 320px; overflow-y: auto;">
                <table class="admin-table">
                    <thead><tr><th>Date</th><th>Product</th><th>Submitted listing</th><th>Email</th><th>Expires</th></tr></thead>
                    <tbody>
                    {% for tip in price_tips %}
                        <tr>
                            <td>{{ tip.submittedAt|date('Y-m-d H:i') }}</td>
                            <td><code>{{ tip.productSlug }}</code></td>
                            <td><a href="{{ tip.listingUrl }}" target="_blank" rel="noopener noreferrer nofollow">Open listing ↗</a></td>
                            <td>{{ tip.email ?: '-' }}</td>
                            <td>{{ tip.expiresAt|date('Y-m-d') }}</td>
                        </tr>
                    {% else %}
                        <tr><td colspan="5" style="text-align: center; color: var(--muted); padding: 24px;">No price tips submitted yet.</td></tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </section>

        <section class="section" style="margin-top: 32px;">
            <div class="section-title">
                <h2>Price Drop Alerts ({{ price_alerts|length }})</h2>
                <span style="font-size: 12px; color: var(--muted);">{{ alert_stats.active }} active · {{ alert_stats.pending }} pending verification · {{ alert_stats.unsubscribed }} unsubscribed</span>
            </div>
            <div class="table-wrap" style="max-height: 320px; overflow-y: auto;">
                <table class="admin-table">
                    <thead><tr><th>Created</th><th>Product</th><th>Email</th><th>Threshold</th><th>Status</th><th>Last Notified</th></tr></thead>
                    <tbody>
                    {% for alert in price_alerts %}
                        <tr>
                            <td>{{ alert.createdAt|date('Y-m-d H:i') }}</td>
                            <td><code>{{ alert.productSlug }}</code></td>
                            <td>{{ alert.email }}</td>
                            <td>{{ alert.targetPriceGrosz ? ((alert.targetPriceGrosz / 100)|number_format(0, '.', ' ')) ~ ' PLN' : 'Any drop' }}</td>
                            <td>
                                {% if alert.status == 'active' and alert.isVerified %}
                                    <span class="badge" style="background: rgba(99, 214, 170, 0.15); color: #63d6aa;">Active</span>
                                {% elseif alert.status == 'unsubscribed' %}
                                    <span class="badge" style="background: rgba(148, 163, 184, 0.15); color: #94a3b8;">Unsubscribed</span>
                                {% else %}
                                    <span class="badge" style="background: rgba(251, 191, 36, 0.15); color: #fbbf24;">Pending verify</span>
                                {% endif %}
                            </td>
                            <td>{{ alert.lastNotifiedAt ? alert.lastNotifiedAt|date('Y-m-d H:i') ~ ' (' ~ ((alert.lastNotifiedPriceGrosz / 100)|number_format(0, '.', ' ')) ~ ' PLN)' : '-' }}</td>
                        </tr>
                    {% else %}
                        <tr><td colspan="6" style="text-align: center; color: var(--muted); padding: 24px;">No price alert subscriptions yet.</td></tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </section>
    </section>

    <script>
        function populateEntryForm(slug, median, low, high) {
            const slugSelect = document.getElementById('entry-slug');
            if (slugSelect) {
                slugSelect.value = slug;
                slugSelect.scrollIntoView({ behavior: 'smooth', block: 'center' });
            }
            if (median) document.getElementById('entry-median').value = median;
            if (low) document.getElementById('entry-low').value = low;
            if (high) document.getElementById('entry-high').value = high;
        }

        function populateProductForm(product) {
            document.getElementById('prod-slug').value = product.slug || '';
            document.getElementById('prod-name').value = product.name || '';
            document.getElementById('prod-category').value = product.category || 'smartphones';
            document.getElementById('prod-definition').value = product.definition || '';
            document.getElementById('prod-family-slug').value = product.family_slug || '';
            document.getElementById('prod-family-name').value = product.family_name || '';
            document.getElementById('prod-image-url').value = product.image || '';
            document.getElementById('prod-image-credit').value = product.image_credit || '';
            document.getElementById('prod-image-source').value = product.image_source || '';
            setSpecificationFields(product.specifications || {});

            document.getElementById('product-editor-title').textContent = '✏️ Edit Product: ' + product.name;
            document.getElementById('prod-submit-btn').textContent = 'Update Product';
            document.getElementById('product-editor-card').scrollIntoView({ behavior: 'smooth', block: 'center' });
        }

        function resetProductForm() {
            document.getElementById('product-form').reset();
            setSpecificationFields({});
            document.getElementById('product-editor-title').textContent = '📦 Product Editor';
            document.getElementById('prod-submit-btn').textContent = 'Save Product';
            document.getElementById('product-editor-card').scrollIntoView({ behavior: 'smooth', block: 'center' });
        }

        function setSpecificationFields(specifications) {
            const editor = document.querySelector('[data-spec-editor]');
            if (!editor) return;
            editor.querySelectorAll('[data-spec-field]').forEach((field) => {
                const value = specifications[field.dataset.specField] || '';
                if (value && ![...field.options].some((option) => option.value === value)) {
                    field.add(new Option(value, value));
                }
                field.value = value;
            });
            document.getElementById('prod-specifications').value = JSON.stringify(specifications, null, 2);
        }

        const productForm = document.getElementById('product-form');
        if (productForm) {
            productForm.addEventListener('submit', () => {
                let specifications = {};
                try {
                    specifications = JSON.parse(document.getElementById('prod-specifications').value || '{}');
                } catch (_) {
                    specifications = {};
                }
                document.querySelectorAll('[data-spec-field]').forEach((field) => {
                    const key = field.dataset.specField;
                    if (field.value) specifications[key] = field.value;
                    else delete specifications[key];
                });
                document.getElementById('prod-specifications').value = JSON.stringify(specifications);
            });
        }
    </script>
{% endblock %}
