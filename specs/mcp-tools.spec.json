{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "IleZa.pl Model Context Protocol (MCP) Tools Specification",
  "description": "Formal contract definition for Polish Market & Tax MCP tools exposed to AI agents.",
  "version": "2.0.0",
  "endpoint": "/mcp",
  "tools": [
    {
      "name": "list_polish_fair_price_products",
      "description": "List products tracked for manual editorial fair-price history in Poland.",
      "parameters": []
    },
    {
      "name": "get_polish_fair_price_product",
      "description": "Get full product specification, family grouping, and media details for a product slug.",
      "parameters": [
        {
          "name": "slug",
          "type": "string",
          "required": true
        }
      ]
    },
    {
      "name": "get_polish_fair_price_history",
      "description": "Get dated manual editorial fair-price estimates for one exact product slug.",
      "parameters": [
        {
          "name": "slug",
          "type": "string",
          "required": true
        }
      ]
    },
    {
      "name": "calculate_polish_income_comparison",
      "description": "Calculate Polish contract and tax net income comparison for a company budget.",
      "parameters": [
        {
          "name": "budget",
          "type": "number",
          "required": true
        },
        {
          "name": "taxation",
          "type": "string",
          "required": false,
          "enum": ["progressive", "linear", "lump"]
        },
        {
          "name": "zus",
          "type": "string",
          "required": false,
          "enum": ["standard", "preferential", "start"]
        }
      ]
    },
    {
      "name": "update_polish_fair_price_observation",
      "description": "Admin tool: Add or update a manual editorial fair-price estimate for a product slug. Authorization is handled via the Authorization header.",
      "parameters": [
        {
          "name": "slug",
          "type": "string",
          "required": true
        },
        {
          "name": "fair_price_pln",
          "type": "number",
          "required": true
        },
        {
          "name": "low_pln",
          "type": "number",
          "required": false
        },
        {
          "name": "high_pln",
          "type": "number",
          "required": false
        },
        {
          "name": "confidence",
          "type": "string",
          "required": false,
          "enum": ["low", "medium", "high"]
        },
        {
          "name": "observed_at",
          "type": "string",
          "required": false
        },
        {
          "name": "summary",
          "type": "string",
          "required": false
        }
      ]
    },
    {
      "name": "create_polish_fair_price_product",
      "description": "Admin tool: Create a new tracked product configuration in the database.",
      "parameters": [
        {
          "name": "slug",
          "type": "string",
          "required": true
        },
        {
          "name": "name",
          "type": "string",
          "required": true
        },
        {
          "name": "category",
          "type": "string",
          "required": true
        },
        {
          "name": "definition",
          "type": "string",
          "required": true
        },
        {
          "name": "family_slug",
          "type": "string",
          "required": false
        },
        {
          "name": "family_name",
          "type": "string",
          "required": false
        },
        {
          "name": "image",
          "type": "string",
          "required": false
        },
        {
          "name": "image_credit",
          "type": "string",
          "required": false
        },
        {
          "name": "image_source",
          "type": "string",
          "required": false
        },
        {
          "name": "specifications_json",
          "type": "string",
          "required": false
        }
      ]
    },
    {
      "name": "update_polish_fair_price_product",
      "description": "Admin tool: Update an existing tracked product configuration in the database.",
      "parameters": [
        {
          "name": "slug",
          "type": "string",
          "required": true
        },
        {
          "name": "name",
          "type": "string",
          "required": false
        },
        {
          "name": "category",
          "type": "string",
          "required": false
        },
        {
          "name": "definition",
          "type": "string",
          "required": false
        },
        {
          "name": "family_slug",
          "type": "string",
          "required": false
        },
        {
          "name": "family_name",
          "type": "string",
          "required": false
        },
        {
          "name": "image",
          "type": "string",
          "required": false
        },
        {
          "name": "image_credit",
          "type": "string",
          "required": false
        },
        {
          "name": "image_source",
          "type": "string",
          "required": false
        },
        {
          "name": "specifications_json",
          "type": "string",
          "required": false
        }
      ]
    },
    {
      "name": "delete_polish_fair_price_product",
      "description": "Admin tool: Delete a tracked product from the database.",
      "parameters": [
        {
          "name": "slug",
          "type": "string",
          "required": true
        }
      ]
    }
  ]
}
